<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/stickerPreviewRoot"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/sticker_preview_background"
	android:orientation="vertical"
	android:paddingHorizontal="@dimen/content_margin"
	android:paddingBottom="@dimen/content_margin">

	<!-- Header: pack + sticker name, and the clear/back affordance. Always wrap_content so the
		 image below is guaranteed whatever height is left over. -->
	<RelativeLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="@dimen/content_margin_top">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:gravity="center_horizontal"
			android:orientation="vertical">

			<TextView
				android:id="@+id/stickerPreviewPackName"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:gravity="center"
				android:maxLines="1"
				android:textColor="@color/accent"
				android:textSize="@dimen/text_size_heading"
				android:textStyle="bold"
				tools:text="Cat Memes" />

			<TextView
				android:id="@+id/stickerPreviewStickerName"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:alpha="0.6"
				android:ellipsize="end"
				android:gravity="center"
				android:maxLines="1"
				android:textColor="@color/fg"
				android:textSize="@dimen/text_size_tiny"
				tools:text="cool_cat.webp" />

		</LinearLayout>

		<ImageButton
			android:id="@+id/stickerPreviewClearButton"
			android:layout_width="@dimen/pack_dimens"
			android:layout_height="@dimen/pack_dimens"
			android:layout_alignParentEnd="true"
			android:layout_centerVertical="true"
			android:background="@drawable/nav_button_background"
			android:contentDescription="@string/close_sticker_preview"
			android:padding="@dimen/nav_button_icon_padding"
			android:scaleType="fitCenter"
			android:src="@drawable/ic_close" />

	</RelativeLayout>

	<!-- Fills whatever height remains below the header, and the sticker inside scales up to
		 fill that space while keeping its aspect ratio. -->
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_marginTop="@dimen/content_margin_top"
		android:layout_weight="1">

		<ImageButton
			android:id="@+id/stickerPreviewImage"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@drawable/sticker_preview_image_background"
			android:contentDescription="@string/send_sticker"
			android:padding="@dimen/card_margin"
			android:scaleType="fitCenter" />

		<ImageButton
			android:id="@+id/stickerPreviewSendButton"
			android:layout_width="@dimen/pack_dimens"
			android:layout_height="@dimen/pack_dimens"
			android:layout_gravity="bottom|end"
			android:layout_margin="@dimen/card_margin"
			android:background="@drawable/nav_button_accent_background"
			android:contentDescription="@string/send_sticker"
			android:padding="@dimen/nav_button_icon_padding"
			android:scaleType="fitCenter"
			android:src="@drawable/ic_send" />

	</FrameLayout>

</LinearLayout>
