<resources>
	<!--
		Base application theme. Only matters for the brief window chrome that exists before Compose
		draws (MainActivity's setContent, KeyboardController's ComposeView) - no classic Android View
		in the app is actually themed by these attributes. Colors are literal, mirroring
		StickerBoardSettingsTheme's light Material 3 ColorScheme (settings/SettingsTheme.kt) by hand;
		see values-night/styles.xml for the dark-mode override. Deliberately no
		android:statusBarColor/navigationBarColor here - the app is edge-to-edge
		(MainActivity.enableEdgeToEdge()), with each page's own composable padding around system bars.
	-->
	<style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<!-- Primary brand color. -->
		<item name="colorPrimaryVariant">#00696C</item>
		<item name="colorOnPrimary">#FFFFFF</item>
		<!-- Customize your theme here. -->
		<item name="colorPrimaryDark">#00696C</item>
		<item name="colorPrimary">#00696C</item>
		<item name="colorAccent">#00696C</item>
		<item name="android:textColorPrimary">#171D1C</item>
		<item name="android:textColorSecondary">#171D1C</item>
		<item name="android:textColor">#171D1C</item>
		<item name="android:windowBackground">#F4FAF9</item>
		<item name="actionOverflowButtonStyle">@style/OverflowButtonStyle</item>
		<item name="actionBarStyle">@style/AppBarBackground</item>
		<item name="actionBarTheme">@style/AppBarText</item>
		<item name="colorSurface">#FFFFFF</item>
		<item name="colorOnSurface">#171D1C</item>
		<item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent
		</item>
		<item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
	</style>

	<style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
		<item name="cornerSize">24dp</item>
	</style>

	<style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
		<item name="cornerSize">24dp</item>
	</style>

	<style name="OverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow">
		<item name="android:tint">#FFFFFF</item>
	</style>

	<style name="AppBarBackground" parent="Widget.MaterialComponents.ActionBar.Solid">
		<item name="android:background">#00696C</item>
	</style>

	<style name="AppBarText" parent="ThemeOverlay.MaterialComponents.ActionBar.Surface">
		<item name="android:textColorPrimary">#FFFFFF</item>
	</style>
</resources>
