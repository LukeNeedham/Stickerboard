<resources>
	<!-- Base application theme. -->
	<style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<!-- Primary brand color. -->
		<item name="colorPrimaryVariant">@color/app_primary</item>
		<item name="colorOnPrimary">@color/app_on_primary</item>
		<!-- Customize your theme here. -->
		<item name="android:navigationBarColor">@color/app_primary</item>
		<item name="colorPrimaryDark">@color/app_primary</item>
		<item name="colorPrimary">@color/app_primary</item>
		<item name="colorAccent">@color/app_primary</item>
		<item name="android:textColorPrimary">@color/app_on_surface</item>
		<item name="android:textColorSecondary">@color/app_on_surface</item>
		<item name="android:textColor">@color/app_on_surface</item>
		<item name="android:windowBackground">@color/app_background</item>
		<item name="actionOverflowButtonStyle">@style/OverflowButtonStyle</item>
		<item name="actionBarStyle">@style/AppBarBackground</item>
		<item name="actionBarTheme">@style/AppBarText</item>
		<item name="colorSurface">@color/app_surface</item>
		<item name="colorOnSurface">@color/app_on_surface</item>
		<item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent
		</item>
		<item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
	</style>

	<style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
		<item name="cornerSize">@dimen/app_component_corner</item>
	</style>

	<style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
		<item name="cornerSize">@dimen/app_component_corner</item>
	</style>

	<style name="OverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow">
		<item name="android:tint">@color/app_on_primary</item>
	</style>

	<style name="AppBarBackground" parent="Widget.MaterialComponents.ActionBar.Solid">
		<item name="android:background">@color/app_primary</item>
	</style>

	<style name="AppBarText" parent="ThemeOverlay.MaterialComponents.ActionBar.Surface">
		<item name="android:textColorPrimary">@color/app_on_primary</item>
	</style>

	<style name="widthMatchHeightWrap">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
	</style>

	<style name="card" parent="widthMatchHeightWrap">
		<item name="android:layout_marginVertical">@dimen/content_margin_top</item>
		<item name="android:textSize">@dimen/zero</item>
	</style>

	<style name="cardchild" parent="widthMatchHeightWrap">
		<item name="android:layout_margin">@dimen/card_margin</item>
	</style>

	<style name="widget" parent="widthMatchHeightWrap">
		<item name="android:layout_marginHorizontal">@dimen/content_margin</item>
		<item name="android:layout_marginTop">@dimen/content_margin_top</item>
		<item name="android:layout_marginBottom">@dimen/content_margin_bottom</item>
		<item name="android:paddingVertical">@dimen/content_margin_top</item>
	</style>

	<style name="body_text" parent="widget">
		<item name="android:textColor">@color/app_on_surface</item>
		<item name="android:textSize">@dimen/text_size_body</item>
		<item name="android:layout_width">wrap_content</item>
	</style>

	<style name="heading" parent="widget">
		<item name="android:textColor">@color/app_primary</item>
		<item name="android:textSize">@dimen/text_size_heading</item>
		<item name="android:textStyle">bold</item>
		<item name="android:layout_marginBottom">@dimen/zero</item>
	</style>

	<style name="section_header" parent="widthMatchHeightWrap">
		<item name="android:textColor">@color/app_on_surface</item>
		<item name="android:textSize">@dimen/text_size_body</item>
		<item name="android:textStyle">bold</item>
		<item name="android:paddingHorizontal">@dimen/content_margin</item>
		<item name="android:paddingTop">@dimen/section_header_top_margin</item>
		<item name="android:paddingBottom">@dimen/content_margin_bottom</item>
	</style>

	<style name="section_empty_message" parent="widthMatchHeightWrap">
		<item name="android:textColor">@color/app_on_surface_variant</item>
		<item name="android:textSize">@dimen/text_size_body</item>
		<item name="android:paddingHorizontal">@dimen/content_margin</item>
		<item name="android:paddingBottom">@dimen/content_margin</item>
	</style>

	<style name="button" parent="body_text">
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_marginVertical">@dimen/zero</item>
		<item name="android:textColor">@color/app_on_primary</item>
	</style>
</resources>
