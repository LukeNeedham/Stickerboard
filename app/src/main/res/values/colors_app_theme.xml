<?xml version="1.0" encoding="utf-8"?>
<!--
	Modern Material 3 palette for the settings app (MainActivity and the pages it opens: onboarding,
	the sticker gallery, debug and crash tools). Deliberately separate from color/accent, color/bg,
	color/fg, color/onAccent and color/pull_handle in colors.xml/themes.xml, which the keyboard IME
	(KeyboardView) reads directly by resource name - restyling the settings app must never change
	how the keyboard itself looks. Mirrors the Compose ColorScheme in settings/SettingsTheme.kt.
-->
<resources>
	<color name="app_primary">#00696C</color>
	<color name="app_on_primary">#FFFFFF</color>
	<color name="app_background">#F4FAF9</color>
	<color name="app_surface">#FFFFFF</color>
	<color name="app_on_surface">#171D1C</color>
</resources>
